###############################################################################
#  DeepTutor backend
###############################################################################
APP_ENV=development # development | staging | production — server-only, read at request time (NEXT_PUBLIC_* would be build-time inlined and can't vary per environment from a single image)
DEEPTUTOR_BASE_URL=http://127.0.0.1:8001
DEEPTUTOR_API_KEY= # optional; leave empty when DeepTutor AUTH_ENABLED=false
DEEPTUTOR_TRANSCRIPTION_LANGUAGE=zh

###############################################################################
#  Learner promo banners
###############################################################################
PROMO_BANNERS_ENABLED=false # "true" to show learner promo banners; content lives in config/promo.ts
