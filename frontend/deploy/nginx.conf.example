# 错题星球前端 · Nginx 部署示例
# 将构建产物 dist/ 上传到 root 指向的目录；本文件不是项目运行时依赖。
# `npm run build:http` 会为 JS/CSS/HTML/SVG 生成 .gz 与 .br 预压缩文件。

server {
    listen 80;
    server_name _;
    root /var/www/mistake-planet;
    index index.html;
    client_max_body_size 12m;

    etag on;

    # 如已安装 ngx_brotli，取消下面两行注释。
    # brotli on;
    # brotli_static on;
    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # 入口文件不缓存，确保新版本立即生效。
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    # Vite 产物带内容哈希，可长期强缓存；字体也在 assets/ 下。
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # 仅存放 OFL 许可证等非哈希文件，使用较短缓存。
    location /fonts/ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # SPA 回退
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# CDN 提示：
# 1. 将 dist/assets/ 整体上传到 CDN，并设置 Cache-Control: public, max-age=31536000, immutable。
# 2. index.html 保留在源站并设置 no-cache；不要把入口 HTML 放到长期缓存。
# 3. 如果 CDN 使用独立域名，请让 CDN 保持 /assets/ 路径不变，或在 Vite 中同步调整 base。
# 4. 预压缩文件需与源文件同路径上传，CDN 开启 brotli_static/gzip_static 等价能力。
